# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# Used by docker-compose for local development

DB_HOST=localhost
# Database server hostname/IP
# - localhost: for local development
# - db: when using docker-compose

DB_PORT=5432
# PostgreSQL default port

DB_USER=postgres
# PostgreSQL superuser (default username)

DB_PASSWORD=your_secure_password_here
# IMPORTANT: Change this for any non-local environment
# Use strong password (20+ chars, mixed case, numbers, symbols)
# NEVER commit actual passwords to repository

DB_NAME=employees_db
# Database name to create/use

# ==========================================
# Application Settings
# ==========================================

ASPNETCORE_ENVIRONMENT=Development
# Values: Development, Staging, Production
# Development: Full error details, hot reload
# Production: Error details hidden, optimized

ASPNETCORE_URLS=http://*:80
# URL and port for application to listen on

PORT_HOST=8080
# Host machine port (for docker-compose port mapping)
# Application will be available at http://localhost:8080